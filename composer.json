{
    "name": "octane-doctor/octane-doctor",
    "description": "Octane readiness scanner for Laravel: detect long-lived worker risks, explain each finding, and gate CI on new ones.",
    "keywords": [
        "laravel",
        "laravel-octane",
        "octane",
        "octane-readiness",
        "long-lived-workers",
        "static-analysis",
        "code-quality",
        "diagnostics",
        "architecture",
        "ci"
    ],
    "homepage": "https://github.com/octane-doctor/octane-doctor",
    "license": "MIT",
    "authors": [
        {
            "name": "Gayan Sanjeewa",
            "email": "iamgayan@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "nikic/php-parser": "^5.0",
        "nunomaduro/termwind": "^1.15||^2.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/finder": "^6.0||^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.0||^8.0",
        "larastan/larastan": "^2.9||^3.0",
        "orchestra/testbench": "^8.22||^9.0||^10.0||^11.0",
        "pestphp/pest": "^2.0||^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^2.0||^3.0||^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^1.2||^2.0",
        "phpstan/phpstan-phpunit": "^1.4||^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "OctaneDoctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OctaneDoctor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OctaneDoctor\\OctaneDoctorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
